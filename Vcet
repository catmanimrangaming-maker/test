                        <label class="block text-xs font-bold text-slate-700 mb-1">Company Name *</label>
                        <input type="text" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-petronas-emerald">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Contact Email *</label>
                        <input type="email" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-petronas-emerald">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Target Sector</label>
                        <select class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-petronas-emerald">
                            <option>MedTech</option>
                            <option>Watchmaking / Horology</option>
                            <option>Automation</option>
                            <option>Automotive</option>
                            <option>Electronics / Connectors</option>
                            <option>Aerospace</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Primary Material</label>
                        <select class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-petronas-emerald">
                            <option>Titanium Grade 5</option>
                            <option>Stainless Steel</option>
                            <option>PEEK / POM</option>
                            <option>Tool Steel</option>
                            <option>Aluminum</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Project Details / Tolerance Requirements</label>
                    <textarea rows="3" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-petronas-emerald" placeholder="Specify quantities, surface finishes, or delivery timelines..."></textarea>
                </div>

                <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg flex justify-between items-center text-xs text-slate-600">
                    <span><i class="fa-solid fa-lock text-petronas-emerald mr-1.5"></i> Strict NDA & Swiss Privacy Guaranteed</span>
                </div>

                <button type="submit" class="w-full py-3 bg-petronas-emerald hover:bg-petronas-darkEmerald text-white font-bold rounded-lg shadow-lg transition">
                    Send RFQ to Engineering Team
                </button>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // DATA OBJECTS
        const fleetData = [
            { cat: 'milling', name: '3-Axis, 4-Axis & 5-Axis CNC Milling', count: 222, icon: 'fa-cube', text: 'High-speed vertical & horizontal milling centers for complex geometries.' },
            { cat: 'grinding', name: 'CNC Grinding Systems', count: 161, icon: 'fa-circle-notch', text: 'Cylindrical 7-axis, surface, jig, honing, and profile grinding.' },
            { cat: 'turning', name: 'CNC Turning & Swiss Lathes', count: 126, icon: 'fa-rotate', text: 'Multi-axis turning centers (4-axis, 5+1 axis, 7-axis) for micro parts.' },
            { cat: 'wirecut', name: 'Wire Cut Electro-Erosion', count: 60, icon: 'fa-bolt', text: 'High-precision wire cut EDM and super drill capabilities.' },
            { cat: 'edm', name: 'Sink EDM Machining', count: 55, icon: 'fa-cubes-stacked', text: 'Die-sinking EDM machines for intricate mold and part cavity work.' }
        ];

        let currentSlide = 1;
        const totalSlides = 6;
        let isPresentationMode = false;

        // INITIALIZE APP
        window.addEventListener('DOMContentLoaded', () => {
            renderFleet('all');
            initCharts();
        });

        // VIEW MODE SWITCHER
        function toggleViewMode() {
            isPresentationMode = !isPresentationMode;
            const webView = document.getElementById('websiteView');
            const presView = document.getElementById('presentationView');
            const modeLabel = document.getElementById('viewModeLabel');

            if (isPresentationMode) {
                webView.classList.add('hidden');
                presView.classList.remove('hidden');
                modeLabel.innerText = "Switch to Web Prototype";
            } else {
                presView.classList.add('hidden');
                webView.classList.remove('hidden');
                modeLabel.innerText = "Switch to Presentation Deck";
            }
        }

        // RENDER FLEET CARDS
        function renderFleet(filter) {
            const container = document.getElementById('fleetContainer');
            container.innerHTML = '';

            const filtered = filter === 'all' ? fleetData : fleetData.filter(d => d.cat === filter);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-slate-800/90 p-6 rounded-xl border border-slate-700/80 hover:border-petronas-emerald transition-all shadow-lg";
                card.innerHTML = `
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-lg bg-petronas-emerald/20 text-petronas-emerald flex items-center justify-center text-lg">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <span class="px-2.5 py-1 bg-petronas-emerald text-white text-xs font-bold rounded-full">${item.count} Machines</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">${item.name}</h3>
                    <p class="text-xs text-slate-300 leading-relaxed">${item.text}</p>
                `;
                container.appendChild(card);
            });
        }

        function filterFleet(category) {
            document.querySelectorAll('.fleet-btn').forEach(btn => {
                btn.className = "fleet-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition";
            });
            event.target.className = "fleet-btn px-4 py-2 rounded-lg text-sm font-medium bg-petronas-emerald text-white transition";
            renderFleet(category);
        }

        // CHART INITIALIZATION
        function initCharts() {
            const ctx = document.getElementById('sectorChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['MedTech', 'Watchmaking', 'Automation', 'Automotive', 'Electronics', 'Aerospace'],
                    datasets: [{
                        data: [48.9, 27.2, 12.0, 10.2, 1.4, 0.3],
                        backgroundColor: [
                            '#00A396',
                            '#0B192C',
                            '#3B82F6',
                            '#F59E0B',
                            '#10B981',
                            '#6366F1'
                        ],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ${context.raw}%`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        }

        // SLIDE PRESENTATION CONTROLS
        function updateSlideUI() {
            for (let i = 1; i <= totalSlides; i++) {
                const slide = document.getElementById(`slide${i}`);
                if (slide) slide.classList.add('hidden');
            }
            document.getElementById(`slide${currentSlide}`).classList.remove('hidden');
            document.getElementById('slideIndicator').innerText = `Slide ${currentSlide} of ${totalSlides}`;

            const dots = document.querySelectorAll('.slide-dot');
            dots.forEach((dot, index) => {
                dot.className = index + 1 === currentSlide ? 
                    "slide-dot w-2.5 h-2.5 rounded-full bg-petronas-emerald cursor-pointer" : 
                    "slide-dot w-2.5 h-2.5 rounded-full bg-slate-700 cursor-pointer";
            });
        }

        function changeSlide(direction) {
            currentSlide += direction;
            if (currentSlide < 1) currentSlide = 1;
            if (currentSlide > totalSlides) currentSlide = totalSlides;
            updateSlideUI();
        }

        function goToSlide(slideNum) {
            currentSlide = slideNum;
            updateSlideUI();
        }

        // LANGUAGE CHANGE SIMULATION
        function changeLang(lang) {
            document.getElementById('currentLang').innerText = lang;
        }

        // MODAL CONTROLS
        function openRFQModal() {
            document.getElementById('rfqModal').classList.remove('hidden');
            document.getElementById('rfqModal').classList.add('flex');
        }

        function closeRFQModal() {
            document.getElementById('rfqModal').classList.add('hidden');
            document.getElementById('rfqModal').classList.remove('flex');
        }

        function handleRFQSubmit(event) {
            event.preventDefault();
            closeRFQModal();
            const notification = document.createElement('div');
            notification.className = "fixed bottom-5 right-5 bg-petronas-emerald text-white px-6 py-4 rounded-xl shadow-2xl z-50 flex items-center space-x-3";
            notification.innerHTML = `<i class="fa-solid fa-circle-check text-xl"></i><div><h4 class="font-bold">RFQ Submitted</h4><p class="text-xs">Thank you! VCET Asia sales team will respond shortly.</p></div>`;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 4000);
        }
    </script>
</body>
</html>
